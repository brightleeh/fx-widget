    "Search here for the ISO code, then type it into a Quote Currency slot in the widget editor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche hier den ISO-Code und tippe ihn dann im Widget-Editor in ein Kurswährungs-Feld ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca aquí el código ISO y escríbelo en una ranura de moneda cotizada del editor del widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherchez ici le code ISO, puis saisissez-le dans un emplacement de devise cotée de l’éditeur."
          }
        },
        "it": {
