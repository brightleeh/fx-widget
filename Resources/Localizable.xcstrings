    "Configure each widget from the desktop’s Edit Widget menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konfiguriere jedes Widget über das Menü „Widget bearbeiten“ auf dem Schreibtisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure each widget from the desktop’s Edit Widget menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Configura cada widget desde el menú «Editar widget» del escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Configurez chaque widget depuis le menu « Modifier le widget » du bureau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Configura ogni widget dal menu «Modifica widget» della scrivania."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップの「ウィジェットを編集」から各ウィジェットを設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱의 위젯 편집 메뉴에서 각 위젯을 설정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Configure cada widget pelo menu “Editar Widget” da mesa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在桌面的“编辑小组件”菜单中配置每个小组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在桌面的「編輯小工具」選單中設定每個小工具。"
          }
        }
      }
    },
