MACOSX_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
ENABLE_USER_SCRIPT_SANDBOXING = YES

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 64

// Local.xcconfig may override only the identity-less bundle identifier prefix.
FX_BUNDLE_ID_PREFIX = com.example

#include? "Local.xcconfig"

FX_APP_BUNDLE_ID = $(FX_BUNDLE_ID_PREFIX).FXWidget
FX_WIDGET_BUNDLE_ID = $(FX_APP_BUNDLE_ID).Widget
FX_TEST_BUNDLE_ID = $(FX_APP_BUNDLE_ID).Tests

DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
