    "FX board settings are stored per widget instance.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FX-Board-Einstellungen werden pro Widget gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FX board settings are stored per widget instance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes del panel de divisas se guardan por widget."
          }
        },
