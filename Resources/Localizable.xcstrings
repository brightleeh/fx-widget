          }
        }
      }
    },
    "This is what the system reports. It can include a widget you already removed from the desktop, and that entry does not go away on its own.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist die Auskunft des Systems. Sie kann ein bereits vom Schreibtisch entferntes Widget enthalten, und dieser Eintrag verschwindet nicht von selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es lo que informa el sistema. Puede incluir un widget que ya quitaste del escritorio, y esa entrada no desaparece por sí sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est ce que rapporte le système. La liste peut contenir un widget déjà retiré du bureau, et cette entrée ne disparaît pas d’elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è ciò che riporta il sistema. Può includere un widget già rimosso dalla scrivania, e quella voce non sparisce da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはシステムが報告している内容です。すでにデスクトップから削除したウィジェットが含まれることがあり、その項目は自然には消えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 보고하는 값입니다. 이미 바탕화면에서 삭제한 위젯이 포함될 수 있으며, 그 항목은 저절로 사라지지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto é o que o sistema informa. Pode incluir um widget que você já removeu da mesa, e essa entrada não some sozinha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是系统报告的内容。可能包含你已从桌面移除的小组件，该条目不会自行消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是系統回報的內容。可能包含你已從桌面移除的小工具，該項目不會自行消失。"
          }
        }
      }
    },
