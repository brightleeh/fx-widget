    "A glanceable exchange-rate board.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselkurse auf einen Blick."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A glanceable exchange-rate board."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipos de cambio de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les taux de change en un coup d’œil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tassi di cambio a colpo d’occhio."
          }
        },
        "ja": {
